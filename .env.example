# ══════════════════════════════════════════════════════════════
# TalkBridge Configuration
# ══════════════════════════════════════════════════════════════
#
# NOTE: TalkBridge is a client-side app. API keys are configured
# in the Settings panel and stored in your browser's localStorage.
#
# If deploying with a backend proxy, set these server-side:
# ══════════════════════════════════════════════════════════════

# ─── Groq API (Required) ─────────────────────────────────────
# Used for:
#   - Whisper STT (speech-to-text)
#   - LLaMA 3.3 translation
# Get your key at: https://console.groq.com

GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── TTS Provider ────────────────────────────────────────────
# Options:
#   - browser     (free, uses Web Speech API)
#   - elevenlabs  (high quality, requires API key)
#   - coqui       (self-hosted, requires XTTS server)

TTS_PROVIDER=browser

# ─── ElevenLabs (if TTS_PROVIDER=elevenlabs) ─────────────────
# Get your key at: https://elevenlabs.io

ELEVENLABS_API_KEY=sk_your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ─── Coqui XTTS (if TTS_PROVIDER=coqui) ──────────────────────
# Run XTTS server:
#   docker run -d --gpus all -p 8080:8080 \
#     ghcr.io/coqui-ai/xtts-streaming-server:latest

XTTS_URL=http://localhost:8080
XTTS_API_TOKEN=

# ─── App Configuration ───────────────────────────────────────
APP_BASE_URL=http://localhost:5173
